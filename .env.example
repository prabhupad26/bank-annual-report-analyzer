# Local development database (docker compose up -d postgres)
DATABASE_URL=postgresql://bank:bank@localhost:5432/bank_reports
# Required when using the keyless SEC EDGAR API; identify yourself with a genuine contact.
SEC_USER_AGENT=BankAnnualReportAnalyzer/0.1 contact@your-domain.org
# Required for BNP Paribas with the FMP provider, and optional for the other four.
FMP_API_KEY=
